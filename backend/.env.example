# =============================================
# AI 电商详情页工作台 - 后端配置
# 复制本文件为 .env 并按需修改
# =============================================

# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8088
APP_DEBUG=true
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 文件存储 =====
# 项目图片/文档落盘的根目录
PROJECTS_ROOT=../projects

# ===== 知识库 =====
# 行业策略、参考案例、Prompt 模板的存储目录
KNOWLEDGE_ROOT=../knowledge

# ===== 数据库 =====
DATABASE_URL=sqlite:///./detail_studio.db

# ===== 生图服务（Image Service） =====
# provider 可选:
#   openai  → GPT Image API / DALL·E 3 (推荐用 gpt-image-1)
#   flux    → Flux 系列 API
#   custom  → 自有 API（OpenAI 兼容协议）
#   mock    → 本地占位（不调用任何API，生成纯色图片）
IMAGE_PROVIDER=mock

# OpenAI GPT Image API 配置示例:
# IMAGE_PROVIDER=openai
# IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# gpt-image-1 专用参数:
# quality: low(1K快速) | medium(2K标准) | high(4K高清) | auto(自动)
IMAGE_QUALITY=auto
# output_format: png | jpeg | webp
IMAGE_OUTPUT_FORMAT=png
# background: transparent | opaque | auto
IMAGE_BACKGROUND=auto

# ===== 文案 / 规划 LLM（AI 思考与文案生成） =====
# provider 可选:
#   openai    → 标准 OpenAI 兼容 API（GPT-4o / Claude / Gemini 等）
#   workbuddy  → 开发时用 WorkBuddy 帮你思考写文案，预生成策略到 knowledge/ 目录
#               运行时直接加载策略文件，不需要单独配置 LLM API Key
#   none      → 纯模板模式，不调用任何 LLM（适合离线开发测试）
TEXT_PROVIDER=none
TEXT_API_KEY=
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4o-mini

# ===== 通用 =====
DEFAULT_IMAGE_RESOLUTION=2K
SUPPORTED_RESOLUTIONS=1K,2K,4K
